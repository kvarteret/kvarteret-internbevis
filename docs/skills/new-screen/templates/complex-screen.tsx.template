import { NativeStackScreenProps } from "@react-navigation/native-stack"
import React, { useLayoutEffect } from "react"
import { ScrollView, View } from "react-native"
import { useTranslation } from "react-i18next"
import { RootStackParamList } from "@/app/navigation/types"
import { Text } from "@/shared/ui/Text"
import { Button } from "@/shared/ui/Button"
import { Card } from "@/shared/ui/Card"
import { use__SCREEN_NAME__VM } from "@/features/__FEATURE_NAME__/vm/use__SCREEN_NAME__VM"

type Props = NativeStackScreenProps<RootStackParamList, "__ROUTE_NAME__">

export const __SCREEN_NAME__ = ({ navigation, route }: Props): React.JSX.Element => {
    const { t } = useTranslation()
    const { state, actions, derived } = use__SCREEN_NAME__VM(route.params)

    useLayoutEffect(() => {
        navigation.setOptions({ title: t("__TITLE_KEY__") })
    }, [navigation, t])

    if (state.isPending) {
        return (
            <View className="flex-1 items-center justify-center">
                <Text>{t("status")}</Text>
            </View>
        )
    }

    if (state.isError) {
        return (
            <View className="flex-1 p-4">
                <Card className="gap-3 p-4">
                    <Text className="text-base">{t("__ERROR_KEY__")}</Text>
                    <Button variant="secondary" onPress={() => void actions.retry()}>
                        <Text className="text-text-primary font-semibold">{t("nowPlayingRetry")}</Text>
                    </Button>
                </Card>
            </View>
        )
    }

    return (
        <ScrollView className="flex-1" contentContainerClassName="p-4 gap-4">
            <Text className="text-xl font-bold">{t("__TITLE_KEY__")}</Text>

            <View className="gap-2">
                <Text className="text-text-secondary">{derived.summary}</Text>
            </View>

            <Button onPress={() => void actions.primary()}>
                <Text className="text-surface font-semibold">{t("__PRIMARY_ACTION_KEY__")}</Text>
            </Button>
        </ScrollView>
    )
}
