            "predictiveBackGestureEnabled": false
        },
        "web": {
            "favicon": "./assets/favicon.png"
        },
        "plugins": ["expo-localization", "expo-secure-store"],
        "extra": {
            "eas": {
                "projectId": "8e46104c-a94c-4205-9884-4f813b6371c3"
