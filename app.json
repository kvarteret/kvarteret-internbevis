{
  "expo": {
    "name": "Samfunnet",
    "slug": "studentersamfunnet-app",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8e46104c-a94c-4205-9884-4f813b6371c3"
    },
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon-square.png",
    "scheme": "internbeviskvarteret",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/launch.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icons/ios-icon-square.png",
      "bundleIdentifier": "com.kvarteret.internbevis.internBevisKvarteret",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icons/android-icon-square.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-adaptive-foreground-square.png",
        "backgroundColor": "#000000"
      },
      "package": "com.kvarteret.internbevis.internBevisKvarteret",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "expo-router",
        {
          "root": "./src/routes"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8e46104c-a94c-4205-9884-4f813b6371c3"
      }
    },
    "owner": "studentersamfunnet-bergen"
  }
}
